{
    "name": "mpesa-etims-middleware",
    "version": "1.0.0",
    "description": "Async M-Pesa (Daraja) + KRA eTIMS middleware",
    "main": "dist/server.js",
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "worker": "tsx src/workers/etims.worker.ts",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:push": "prisma db push",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@fastify/cookie": "^9.4.0",
        "@fastify/cors": "^9.0.1",
        "@fastify/env": "^4.3.0",
        "@prisma/client": "^5.22.0",
        "axios": "^1.7.7",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.21.2",
        "dotenv": "^16.4.5",
        "fastify": "^4.28.1",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.3",
        "pino": "^9.4.0",
        "pino-pretty": "^11.2.2",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.7.5",
        "prisma": "^5.22.0",
        "tsx": "^4.19.1",
        "typescript": "^5.6.3",
        "vitest": "^2.1.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@prisma/client",
            "@prisma/engines",
            "prisma",
            "esbuild",
            "msgpackr-extract"
        ]
    }
}
