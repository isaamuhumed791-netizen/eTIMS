generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum InvoiceStatus {
  QUEUED
  SUBMITTED
  FAILED
}

model Tenant {
  id                     String        @id @default(uuid())
  name                   String
  slug                   String        @unique
  email                  String        @unique
  phone                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  tin                    String?
  bhfId                  String?
  dvcSrlNo               String?
  cmcKeyEnc              String?
  etimsConnectedAt       DateTime?

  mpesaConsumerKeyEnc    String?
  mpesaConsumerSecretEnc String?
  mpesaPasskeyEnc        String?
  mpesaShortcode         String?
  mpesaEnv               String        @default("sandbox")
  mpesaConnectedAt       DateTime?

  

  plan                 String    @default("FOUNDING")

  planExpiresAt        DateTime?

  billingProvider      String?

  billingCustomerId    String?

  billingSubscriptionId String?

  users                  User[]
  apiKeys                ApiKey[]
  transactions           Transaction[]
  invoices               Invoice[]

  @@index([slug])
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  fullName     String
  role         String    @default("OWNER")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model ApiKey {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  keyHash   String    @unique
  lastUsed  DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId])
}

model Transaction {
  id                 String            @id @default(uuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mpesaReceiptNumber String?           @unique
  checkoutRequestId  String?           @unique
  merchantRequestId  String?
  amount             Decimal           @db.Decimal(12, 2)
  phoneNumber        String
  status             TransactionStatus @default(PENDING)
  rawCallbackData    Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  invoice            Invoice?

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model Invoice {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId    String        @unique
  transaction      Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  kraInvoiceNumber String?
  sdcId            String?
  receiptSignature String?
  status           InvoiceStatus @default(QUEUED)
  errorMessage     String?
  retryCount       Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId])
  @@index([status])
}

model EtimsConfig {
  id        String   @id @default("default")
  cmcKey    String
  tin       String
  bhfId     String
  dvcSrlNo  String
  updatedAt DateTime @updatedAt
}
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model ErrorEvent {
  id          String    @id @default(uuid())
  tenantId    String?
  source      String
  message     String
  stack       String?
  context     Json?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([tenantId])
  @@index([source])
  @@index([resolved])
  @@index([lastSeenAt])
}